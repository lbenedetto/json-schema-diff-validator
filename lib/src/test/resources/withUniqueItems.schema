{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Foo": {
      "type": "object",
      "properties": {
        "Bar": {
          "type": [
            "array"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "uniqueItems": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "Bar"
      ]
    }
  }
}
